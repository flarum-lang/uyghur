{
	"name": "flarum-lang/uyghur",
	"description": "Uyghur Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/uyghur",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/uyghur/issues",
		"forum": "https://discuss.flarum.org/d/40221",
		"source": "https://github.com/flarum-lang/uyghur"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Uyghur",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ug",
			"title": "ئۇيغۇرچە",
			"direction": "rtl"
		}
	}
}
